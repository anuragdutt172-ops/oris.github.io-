                color: 0xef4444,
                shape: 'vessels',
                position: { x: 0, y: 0.7, z: -0.02 },
                scale: { x: 0.12, y: 1.1, z: 0.12 },
                description: 'The main systemic artery arising from the left ventricle carrying oxygenated blood.',
                function: 'Distributes oxygen-rich blood throughout systemic circulation.',
                clinical: 'Aortic aneurysms represent life-threatening structural arterial ballooning.'
            },
            {
                id: 'vena_cava',
                name: 'Vena Cava & Major Veins',
                latin: 'Vena Cava',
                system: 'cardiovascular',
                color: 0x0284c7,
                shape: 'vessels',
                position: { x: 0.05, y: 0.7, z: -0.02 },
                scale: { x: 0.1, y: 1.1, z: 0.1 },
                description: 'Large venous channels draining deoxygenated systemic blood back into the right atrium.',
                function: 'Returns deoxygenated blood from upper and lower body to the heart.',
                clinical: 'Deep vein thrombosis (DVT) in lower limbs can embolize to pulmonary arteries.'
            },

            // NERVOUS SYSTEM
            {
                id: 'spinal_cord',
                name: 'Spinal Cord & Main Nerves',
                latin: 'Medulla spinalis',
                system: 'nervous',
                color: 0xeab308,
                shape: 'nerve_tree',
                position: { x: 0, y: 0.75, z: -0.05 },
                scale: { x: 0.18, y: 1.3, z: 0.12 },
                description: 'A long, fragile tube-like structure that begins at the end of the brainstem and continues down almost to the bottom of the spine.',
                function: 'Transmits nerve signals between the brain and the rest of the body.',
                clinical: 'Traumatic spinal cord injury causes permanent loss of sensation and motor paralysis below the lesion level.'
            }
        ];

        // System Configurations and Default Opacity
        const SYSTEMS = {
            skeletal: { name: 'Skeletal System', color: '#e2e8f0', icon: 'fa-bone', opacity: 1.0, visible: true },
            muscular: { name: 'Muscular System', color: '#f43f5e', icon: 'fa-child', opacity: 0.85, visible: true },
            organs: { name: 'Internal Organs', color: '#f97316', icon: 'fa-heart-pulse', opacity: 1.0, visible: true },
            cardiovascular: { name: 'Cardiovascular System', color: '#06b6d4', icon: 'fa-droplet', opacity: 0.7, visible: true },
            nervous: { name: 'Nervous System', color: '#eab308', icon: 'fa-bolt', opacity: 0.8, visible: true }
        };

        // Global App State
        let scene, camera, renderer, controls;
        let anatomicalMeshMap = new Map(); // id -> THREE.Mesh
        let raycaster, mouse;
        let hoveredMesh = null;
        let selectedMesh = null;
        let appMode = 'explore'; // 'explore' or 'quiz'
        let currentQuizItem = null;
        let quizScore = 0;
        let clippingPlane;

        /**
         * Initialize Three.js 3D WebGL World
         */
        function init3D() {
            const container = document.getElementById('canvas-container');
            const width = container.clientWidth;
            const height = container.clientHeight;

            // Scene setup
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0a0f1d);
            scene.fog = new THREE.FogExp2(0x0a0f1d, 0.15);

            // Camera setup
            camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
            camera.position.set(0, 1.0, 3.2);

            // Renderer setup
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: "high-performance" });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.localClippingEnabled = true;
            container.appendChild(renderer.domElement);

            // Orbit Controls
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.maxDistance = 6;
            controls.minDistance = 0.8;
            controls.target.set(0, 0.7, 0);

            // Lighting Setup
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            const mainLight = new THREE.DirectionalLight(0xffffff, 0.8);
            mainLight.position.set(2, 4, 3);
            mainLight.castShadow = true;
            scene.add(mainLight);

            const fillLight = new THREE.DirectionalLight(0x38bdf8, 0.4);
            fillLight.position.set(-3, 1, -2);
            scene.add(fillLight);

            const rimLight = new THREE.DirectionalLight(0xf43f5e, 0.3);
            rimLight.position.set(0, -3, -2);
            scene.add(rimLight);

            // Clipping Plane for Cross-section / Slicing
            clippingPlane = new THREE.Plane(new THREE.Vector3(-1, 0, 0), 1.5);

            // Raycaster for Picking
            raycaster = new THREE.Raycaster();
            mouse = new THREE.Vector2();

            // Build Anatomical Models
            buildAnatomyModels();

            // Setup Interactions
            window.addEventListener('resize', onWindowResize);
            container.addEventListener('mousemove', onMouseMove);
            container.addEventListener('click', onClickCanvas);

            // Render Loop
            animate();
        }

        /**
         * Procedurally constructs realistic 3D mesh geometries for anatomy parts
         */
        function createAnatomyGeometry(type) {
            let geom;
            switch(type) {
                case 'skull':
                    geom = new THREE.SphereGeometry(1, 32, 24);
                    geom.scale(1, 1.2, 1.1);
                    break;
                case 'spine':
                    geom = new THREE.CylinderGeometry(0.5, 0.6, 2, 16, 20);
                    break;
                case 'ribcage':
                    geom = new THREE.TorusGeometry(1, 0.15, 12, 32);
                    geom.scale(1, 1.3, 0.8);
                    break;
                case 'pelvis':
                    geom = new THREE.TorusGeometry(1, 0.25, 12, 24, Math.PI * 1.2);
                    geom.rotateX(Math.PI / 2);
                    break;
                case 'bone_long':
                    geom = new THREE.CylinderGeometry(0.4, 0.4, 2, 16);
                    break;
                case 'chest_muscle':
                    geom = new THREE.BoxGeometry(1.2, 0.8, 0.4);
                    break;
                case 'limb_muscle':
                    geom = new THREE.CapsuleGeometry ? new THREE.CapsuleGeometry(0.5, 1, 8, 16) : new THREE.CylinderGeometry(0.5, 0.5, 1.5, 16);
                    break;
                case 'brain':
                    geom = new THREE.SphereGeometry(1, 24, 20);
                    geom.scale(1, 0.85, 1.15);
                    break;
                case 'heart':
                    geom = new THREE.DodecahedronGeometry(1, 2);
                    geom.scale(0.9, 1.2, 0.9);
                    break;
                case 'lungs':
                    geom = new THREE.BoxGeometry(1.2, 1.2, 0.8);
                    break;
                case 'liver':
                    geom = new THREE.ConeGeometry(1, 1, 16);
                    geom.rotateZ(-Math.PI / 3);
                    break;
                case 'vessels':
                case 'nerve_tree':
                    geom = new THREE.CylinderGeometry(0.2, 0.1, 2, 12);
                    break;
                default:
                    geom = new THREE.SphereGeometry(1, 16, 16);
            }
            return geom;
        }

        /**
         * Construct all anatomy objects in 3D scene
         */
        function buildAnatomyModels() {
            ANATOMY_DATA.forEach(data => {
                const geometry = createAnatomyGeometry(data.shape);
                const systemConfig = SYSTEMS[data.system];

                const material = new THREE.MeshStandardMaterial({
                    color: data.color,
                    roughness: 0.4,
                    metalness: 0.1,
                    transparent: true,
                    opacity: systemConfig ? systemConfig.opacity : 1.0,
                    clippingPlanes: [clippingPlane],
                    clipShadows: true
                });

                const mesh = new THREE.Mesh(geometry, material);
                mesh.position.set(data.position.x, data.position.y, data.position.z);
                mesh.scale.set(data.scale.x, data.scale.y, data.scale.z);
                mesh.castShadow = true;
                mesh.receiveShadow = true;

                // Attach custom metadata
                mesh.userData = { ...data, originalPosition: { ...data.position } };

                scene.add(mesh);
                anatomicalMeshMap.set(data.id, mesh);
            });
        }

        /**
         * Mouse Movement & Raycasting Hover Handler
         */
        function onMouseMove(event) {
            const container = document.getElementById('canvas-container');
            const rect = container.getBoundingClientRect();
            mouse.x = ((event.clientX - rect.left) / container.clientWidth) * 2 - 1;
            mouse.y = -((event.clientY - rect.top) / container.clientHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const visibleMeshes = Array.from(anatomicalMeshMap.values()).filter(m => m.visible);
            const intersects = raycaster.intersectObjects(visibleMeshes);

            const tooltip = document.getElementById('3d-tooltip');

            if (intersects.length > 0) {
                const firstHit = intersects[0].object;
                if (hoveredMesh !== firstHit) {
                    if (hoveredMesh && hoveredMesh !== selectedMesh) {
                        unhighlightMesh(hoveredMesh);
                    }
                    hoveredMesh = firstHit;
                    if (hoveredMesh !== selectedMesh) {
                        highlightMesh(hoveredMesh, 0x38bdf8);
                    }
                }
                
                // Position Tooltip near cursor
                tooltip.style.left = (event.clientX + 12) + 'px';
                tooltip.style.top = (event.clientY + 12) + 'px';
                tooltip.classList.remove('hidden');
                document.getElementById('tooltip-text').innerText = hoveredMesh.userData.name;
                container.style.cursor = 'pointer';
            } else {
                if (hoveredMesh && hoveredMesh !== selectedMesh) {
                    unhighlightMesh(hoveredMesh);
                }
                hoveredMesh = null;
                tooltip.classList.add('hidden');
                container.style.cursor = 'grab';
            }
        }

        /**
         * Canvas Click Handler for Structure Selection
         */
        function onClickCanvas() {
            if (hoveredMesh) {
                if (appMode === 'quiz') {
                    handleQuizSelection(hoveredMesh);
                } else {
                    selectStructure(hoveredMesh);
                }
            }
        }

        /**
         * Select and focus on a specific anatomical structure
         */
        function selectStructure(mesh) {
            if (selectedMesh && selectedMesh !== mesh) {
                unhighlightMesh(selectedMesh);
            }

            selectedMesh = mesh;
            highlightMesh(selectedMesh, 0x38bdf8);

            // Enable HUD buttons
            document.getElementById('btn-isolate').disabled = false;
            document.getElementById('btn-hide').disabled = false;

            // Smooth camera zoom towards selected object
            focusCameraOnMesh(selectedMesh);

            // Render details in side panel
            renderStructureDetails(selectedMesh.userData);
        }

        function highlightMesh(mesh, hexColor) {
            mesh.material.emissive = new THREE.Color(hexColor);
            mesh.material.emissiveIntensity = 0.4;
        }

        function unhighlightMesh(mesh) {
            mesh.material.emissive = new THREE.Color(0x000000);
            mesh.material.emissiveIntensity = 0.0;
        }

        /**
         * Smooth camera transition using TWEEN
         */
        function focusCameraOnMesh(mesh) {
            const targetPos = mesh.position;
            
            new TWEEN.Tween(controls.target)
                .to({ x: targetPos.x, y: targetPos.y, z: targetPos.z }, 800)
                .easing(TWEEN.Easing.Cubic.Out)
                .start();

            const offsetDir = new THREE.Vector3().subVectors(camera.position, controls.target).normalize();
            const newCamPos = new THREE.Vector3().addVectors(targetPos, offsetDir.multiplyScalar(1.2));

            new TWEEN.Tween(camera.position)
                .to({ x: newCamPos.x, y: newCamPos.y, z: newCamPos.z }, 800)
                .easing(TWEEN.Easing.Cubic.Out)
                .start();
        }

        function resetCameraView() {
            new TWEEN.Tween(controls.target)
                .to({ x: 0, y: 0.7, z: 0 }, 800)
                .easing(TWEEN.Easing.Cubic.Out)
                .start();

            new TWEEN.Tween(camera.position)
                .to({ x: 0, y: 1.0, z: 3.2 }, 800)
                .easing(TWEEN.Easing.Cubic.Out)
                .start();
        }

        /**
         * Render Structure Detail Information Card
         */
        function renderStructureDetails(data) {
            document.getElementById('empty-detail-state').classList.add('hidden');
            document.getElementById('active-detail-state').classList.remove('hidden');

            document.getElementById('detail-title').innerText = data.name;
            document.getElementById('detail-latin').innerText = data.latin;
            document.getElementById('detail-description').innerText = data.description;
            document.getElementById('detail-function').innerText = data.function;
            document.getElementById('detail-clinical').innerText = data.clinical;

            const badge = document.getElementById('structure-system-badge');
            const system = SYSTEMS[data.system];
            badge.innerText = system ? system.name : data.system;
            badge.style.color = system ? system.color : '#fff';
        }

        /**
         * Build system opacity controls dynamically in left sidebar
         */
        function buildSystemControls() {
            const container = document.getElementById('system-sliders-container');
            container.innerHTML = '';

            Object.keys(SYSTEMS).forEach(sysKey => {
                const sys = SYSTEMS[sysKey];
                const card = document.createElement('div');
                card.className = 'bg-slate-900/80 p-2.5 rounded-lg border border-slate-800 space-y-2';

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <i class="fa-solid ${sys.icon} text-xs" style="color: ${sys.color}"></i>
                            <span class="text-xs font-semibold text-slate-200">${sys.name}</span>
                        </div>
                        <button onclick="toggleSystemVisibility('${sysKey}')" id="vis-btn-${sysKey}" class="text-slate-400 hover:text-white text-xs">
                            <i class="fa-solid ${sys.visible ? 'fa-eye' : 'fa-eye-slash'}"></i>
                        </button>
                    </div>
                    <div class="flex items-center space-x-2">
                        <input type="range" min="0" max="1" step="0.05" value="${sys.opacity}" 
                               class="w-full h-1 bg-slate-700 rounded-lg appearance-none cursor-pointer"
                               oninput="updateSystemOpacity('${sysKey}', this.value)">
                        <span id="opacity-val-${sysKey}" class="text-[10px] text-slate-400 font-mono w-7 text-right">${Math.round(sys.opacity * 100)}%</span>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function updateSystemOpacity(systemKey, val) {
            const opacity = parseFloat(val);
            SYSTEMS[systemKey].opacity = opacity;
            document.getElementById(`opacity-val-${systemKey}`).innerText = `${Math.round(opacity * 100)}%`;

            anatomicalMeshMap.forEach(mesh => {
                if (mesh.userData.system === systemKey) {
                    mesh.material.opacity = opacity;
                }
            });
        }

        function toggleSystemVisibility(systemKey) {
            const sys = SYSTEMS[systemKey];
            sys.visible = !sys.visible;

            const btn = document.getElementById(`vis-btn-${systemKey}`);
            btn.innerHTML = `<i class="fa-solid ${sys.visible ? 'fa-eye' : 'fa-eye-slash'}"></i>`;

            anatomicalMeshMap.forEach(mesh => {
                if (mesh.userData.system === systemKey) {
                    mesh.visible = sys.visible;
                }
            });
        }

        /**
         * Cross Section Plane Slice Tool
         */
        function updateCrossSection(val) {
            const sliceVal = parseFloat(val);
            clippingPlane.constant = sliceVal;
            document.getElementById('slice-val').innerText = sliceVal >= 1.45 ? 'Off' : `${sliceVal.toFixed(2)}m`;
        }

        /**
         * Exploded View Expansion Slider
         */
        function updateExplodedView(val) {
            const factor = parseFloat(val);
            document.getElementById('explode-val').innerText = `${Math.round(factor * 100)}%`;

            anatomicalMeshMap.forEach(mesh => {
                const orig = mesh.userData.originalPosition;
                mesh.position.x = orig.x + (orig.x * factor * 1.2);
                mesh.position.y = orig.y + ((orig.y - 0.7) * factor * 0.8);
                mesh.position.z = orig.z + (orig.z * factor * 1.5);
            });
        }

        /**
         * Structure Isolation / Hiding Actions
         */
        function isolateSelectedStructure() {
            if (!selectedMesh) return;
            anatomicalMeshMap.forEach(mesh => {
                mesh.visible = (mesh === selectedMesh);
            });
        }

        function hideSelectedStructure() {
            if (!selectedMesh) return;
            selectedMesh.visible = false;
        }

        function showAllStructures() {
            anatomicalMeshMap.forEach(mesh => {
                mesh.visible = true;
            });
        }

        function toggleWireframe() {
            anatomicalMeshMap.forEach(mesh => {
                mesh.material.wireframe = !mesh.material.wireframe;
            });
            document.getElementById('btn-wireframe').classList.toggle('text-sky-400');
        }

        /**
         * Search Handler with Auto-Focus
         */
        function handleSearch(query) {
            const clearBtn = document.getElementById('clear-search');
            if (query.trim().length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
                return;
            }

            const q = query.toLowerCase();
            const matched = ANATOMY_DATA.find(d => d.name.toLowerCase().includes(q) || d.latin.toLowerCase().includes(q));

            if (matched) {
                const mesh = anatomicalMeshMap.get(matched.id);
                if (mesh) {
                    mesh.visible = true;
                    selectStructure(mesh);
                }
            }
        }

        function clearSearch() {
            document.getElementById('search-input').value = '';
            document.getElementById('clear-search').classList.add('hidden');
        }

        /**
         * Hierarchy Tree Construction
         */
        function buildHierarchyTree() {
            const treeContainer = document.getElementById('tab-tree');
            treeContainer.innerHTML = '';

            Object.keys(SYSTEMS).forEach(sysKey => {
                const sys = SYSTEMS[sysKey];
                const sysItems = ANATOMY_DATA.filter(d => d.system === sysKey);

                const groupDiv = document.createElement('div');
                groupDiv.className = 'space-y-1 mb-2';

                groupDiv.innerHTML = `
                    <div class="text-xs font-bold text-slate-300 py-1 px-2 bg-slate-900 rounded flex items-center space-x-2">
                        <i class="fa-solid ${sys.icon}" style="color: ${sys.color}"></i>
                        <span>${sys.name}</span>
                    </div>
                    <div class="pl-4 space-y-1 border-l border-slate-800 ml-2">
                        ${sysItems.map(item => `
                            <button onclick="selectStructureById('${item.id}')" class="w-full text-left text-xs text-slate-400 hover:text-sky-400 py-1 px-2 rounded hover:bg-slate-900/50 transition-colors block truncate">
                                ${item.name}
                            </button>
                        `).join('')}
                    </div>
                `;

                treeContainer.appendChild(groupDiv);
            });
        }

        function selectStructureById(id) {
            const mesh = anatomicalMeshMap.get(id);
            if (mesh) {
                mesh.visible = true;
                selectStructure(mesh);
            }
        }

        function switchSidebarTab(tab) {
            const sysTab = document.getElementById('tab-systems');
            const treeTab = document.getElementById('tab-tree');
            const sysBtn = document.getElementById('tab-systems-btn');
            const treeBtn = document.getElementById('tab-tree-btn');

            if (tab === 'systems') {
                sysTab.classList.remove('hidden');
                treeTab.classList.add('hidden');
                sysBtn.className = 'flex-1 py-2.5 text-center text-sky-400 border-b-2 border-sky-400 transition-all';
                treeBtn.className = 'flex-1 py-2.5 text-center text-slate-400 border-b-2 border-transparent hover:text-slate-200 transition-all';
            } else {
                sysTab.classList.add('hidden');
                treeTab.classList.remove('hidden');
                treeBtn.className = 'flex-1 py-2.5 text-center text-sky-400 border-b-2 border-sky-400 transition-all';
                sysBtn.className = 'flex-1 py-2.5 text-center text-slate-400 border-b-2 border-transparent hover:text-slate-200 transition-all';
            }
        }

        /**
         * Quiz / Identification Mode Logic
         */
        function setAppMode(mode) {
            appMode = mode;
            const exploreBtn = document.getElementById('mode-explore-btn');
            const quizBtn = document.getElementById('mode-quiz-btn');
            const quizHud = document.getElementById('quiz-hud');

            if (mode === 'quiz') {
                exploreBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all border border-slate-700';
                quizBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20 transition-all font-bold';
                quizHud.classList.remove('hidden');
                nextQuizQuestion();
            } else {
                quizBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all border border-slate-700';
                exploreBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 bg-sky-500 text-white shadow-md shadow-sky-500/20 transition-all';
                quizHud.classList.add('hidden');
            }
        }

        function nextQuizQuestion() {
            const randomIndex = Math.floor(Math.random() * ANATOMY_DATA.length);
            currentQuizItem = ANATOMY_DATA[randomIndex];
            document.getElementById('quiz-question').innerHTML = `Click on the: <span class="text-amber-300 underline underline-offset-4 font-bold">${currentQuizItem.name}</span>`;
            
            // Ensure target is visible
            const targetMesh = anatomicalMeshMap.get(currentQuizItem.id);
            if (targetMesh) targetMesh.visible = true;
        }

        function handleQuizSelection(mesh) {
            if (mesh.userData.id === currentQuizItem.id) {
                highlightMesh(mesh, 0x10b981); // Emerald pulse for correct
                quizScore += 10;
                document.getElementById('quiz-score').innerText = quizScore;
                setTimeout(() => {
                    unhighlightMesh(mesh);
                    nextQuizQuestion();
                }, 700);
            } else {
                highlightMesh(mesh, 0xf43f5e); // Red pulse for wrong
                setTimeout(() => unhighlightMesh(mesh), 600);
            }
        }

        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        function onWindowResize() {
            const container = document.getElementById('canvas-container');
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        /**
         * Main Render & Animation Loop
         */
        function animate(time) {
            requestAnimationFrame(animate);
            TWEEN.update();
            controls.update();

            // Gentle rotation animation for pulsating heart or dynamic structures
            const heartMesh = anatomicalMeshMap.get('heart');
            if (heartMesh) {
                const scalePulse = 0.16 + Math.sin(time * 0.005) * 0.006;
                heartMesh.scale.set(scalePulse, scalePulse * 1.1, scalePulse);
            }

            renderer.render(scene, camera);
        }

        // Initialize application on window load
        window.onload = function() {
            init3D();
            buildSystemControls();
            buildHierarchyTree();
        };
    </script>
</body>
</html>