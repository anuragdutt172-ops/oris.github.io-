<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Human Anatomy Interactive Atlas</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Three.js and OrbitControls -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        medical: {
                            bg: '#0a0f1d',
                            panel: '#111827',
                            border: '#1f293d',
                            accent: '#38bdf8',
                            glow: '#0284c7',
                            card: 'rgba(17, 24, 39, 0.85)',
                            bone: '#e2e8f0',
                            muscle: '#f43f5e',
                            organ: '#f97316',
                            nerve: '#eab308',
                            vessel: '#06b6d4'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0a0f1d;
            color: #f3f4f6;
            overflow: hidden;
            user-select: none;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #38bdf8;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(56, 189, 248, 0.15);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .glow-effect {
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
        }

        /* Tooltip styling */
        #3d-tooltip {
            pointer-events: none;
            transition: opacity 0.15s ease;
        }

        /* Custom slider styling */
        input[type=range] {
            accent-color: #38bdf8;
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col antialiased">

    <!-- Top Header / App Navigation -->
    <header class="h-14 border-b border-gray-800 bg-slate-950/80 backdrop-blur px-4 flex items-center justify-between z-30 flex-shrink-0">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-sky-500 to-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-sky-500/30">
                <i class="fa-solid font-bold fa-cube"></i>
            </div>
            <div>
                <h1 class="font-bold text-base tracking-wide bg-gradient-to-r from-white via-slate-200 to-sky-400 bg-clip-text text-transparent">ANATOMIA 3D</h1>
                <p class="text-[10px] text-sky-400 font-medium tracking-wider uppercase">Interactive Human Body Atlas</p>
            </div>
        </div>

        <!-- Mode Switches & Tools Header Bar -->
        <div class="flex items-center space-x-2">
            <button id="mode-explore-btn" onclick="setAppMode('explore')" class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 bg-sky-500 text-white shadow-md shadow-sky-500/20 transition-all">
                <i class="fa-solid fa-microscope"></i>
                <span>Explore</span>
            </button>
            <button id="mode-quiz-btn" onclick="setAppMode('quiz')" class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all border border-slate-700">
                <i class="fa-solid fa-graduation-cap"></i>
                <span>Quiz Mode</span>
            </button>
            <div class="h-5 w-px bg-slate-800 mx-1"></div>
            <button id="btn-fullscreen" onclick="toggleFullscreen()" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition-colors">
                <i class="fa-solid fa-expand text-xs"></i>
            </button>
        </div>
    </header>

    <!-- Main Body Container -->
    <div class="flex-1 flex overflow-hidden relative">

        <!-- Left Sidebar: System Hierarchy & Search -->
        <aside id="sidebar" class="w-80 border-r border-slate-800/80 bg-slate-950/70 backdrop-blur-md flex flex-col z-20 transition-all duration-300 ease-in-out relative">
            <!-- Search Input -->
            <div class="p-3 border-b border-slate-800">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="search-input" placeholder="Search structure (e.g., Femur, Heart)..." 
                           class="w-full bg-slate-900 border border-slate-700/80 rounded-lg pl-9 pr-8 py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-sky-500 transition-colors"
                           oninput="handleSearch(this.value)">
                    <button id="clear-search" onclick="clearSearch()" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>

            <!-- Tabs: Systems / Tree -->
            <div class="flex border-b border-slate-800 text-xs font-medium bg-slate-900/50">
                <button id="tab-systems-btn" onclick="switchSidebarTab('systems')" class="flex-1 py-2.5 text-center text-sky-400 border-b-2 border-sky-400 transition-all">Systems</button>
                <button id="tab-tree-btn" onclick="switchSidebarTab('tree')" class="flex-1 py-2.5 text-center text-slate-400 border-b-2 border-transparent hover:text-slate-200 transition-all">Hierarchy</button>
            </div>

            <!-- Tab Content: System Controls -->
            <div id="tab-systems" class="flex-1 overflow-y-auto p-3 space-y-4">
                <div class="text-[11px] font-semibold tracking-wider text-slate-400 uppercase mb-2">Anatomical Layer Opacity</div>
                
                <!-- System Visibility & Opacity Sliders -->
                <div class="space-y-3" id="system-sliders-container">
                    <!-- Populated dynamically via JS -->
                </div>

                <!-- Tools & Filters -->
                <div class="pt-4 border-t border-slate-800 space-y-3">
                    <div class="text-[11px] font-semibold tracking-wider text-slate-400 uppercase">Interactive Tools</div>
                    
                    <!-- Cross Section / Slice Tool Slider -->
                    <div class="bg-slate-900/80 p-3 rounded-lg border border-slate-800">
                        <div class="flex items-center justify-between text-xs mb-1.5">
                            <span class="text-slate-300 font-medium flex items-center space-x-1.5">
                                <i class="fa-solid fa-scissors text-sky-400 text-xs"></i>
                                <span>Sagittal Plane Slice</span>
                            </span>
                            <span id="slice-val" class="text-slate-500 text-[10px]">Off</span>
                        </div>
                        <input type="range" id="slice-slider" min="-1.5" max="1.5" step="0.02" value="1.5" class="w-full h-1.5 bg-slate-700 rounded-lg appearance-none cursor-pointer" oninput="updateCrossSection(this.value)">
                    </div>

                    <!-- Exploded View Slider -->
                    <div class="bg-slate-900/80 p-3 rounded-lg border border-slate-800">
                        <div class="flex items-center justify-between text-xs mb-1.5">
                            <span class="text-slate-300 font-medium flex items-center space-x-1.5">
                                <i class="fa-solid fa-arrows-up-down-left-right text-sky-400 text-xs"></i>
                                <span>Exploded View Expansion</span>
                            </span>
                            <span id="explode-val" class="text-slate-500 text-[10px]">0%</span>
                        </div>
                        <input type="range" id="explode-slider" min="0" max="1" step="0.01" value="0" class="w-full h-1.5 bg-slate-700 rounded-lg appearance-none cursor-pointer" oninput="updateExplodedView(this.value)">
                    </div>
                </div>
            </div>

            <!-- Tab Content: Structure Hierarchy Tree -->
            <div id="tab-tree" class="flex-1 overflow-y-auto p-3 hidden space-y-1" id="tree-container">
                <!-- Structure Tree Populated via JS -->
            </div>
        </aside>

        <!-- Center Viewport (Three.js WebGL Canvas Container) -->
        <main class="flex-1 relative bg-slate-950 overflow-hidden flex flex-col">
            <!-- 3D Canvas Element -->
            <div id="canvas-container" class="w-full h-full absolute inset-0 cursor-grab active:cursor-grabbing"></div>

            <!-- Dynamic Floating HUD Controls Bar -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 glass-panel rounded-full px-4 py-2 flex items-center space-x-3 z-10 shadow-2xl">
                <button onclick="resetCameraView()" class="p-2 text-slate-300 hover:text-sky-400 hover:bg-slate-800/60 rounded-full transition-all" title="Reset Camera View">
                    <i class="fa-solid fa-arrows-to-dot text-sm"></i>
                </button>
                <div class="h-4 w-px bg-slate-700"></div>
                <button onclick="isolateSelectedStructure()" id="btn-isolate" class="p-2 text-slate-300 hover:text-sky-400 hover:bg-slate-800/60 rounded-full transition-all disabled:opacity-30" title="Isolate Selected Structure">
                    <i class="fa-solid fa-filter text-sm"></i>
                </button>
                <button onclick="hideSelectedStructure()" id="btn-hide" class="p-2 text-slate-300 hover:text-rose-400 hover:bg-slate-800/60 rounded-full transition-all disabled:opacity-30" title="Hide Structure">
                    <i class="fa-solid fa-eye-slash text-sm"></i>
                </button>
                <button onclick="showAllStructures()" class="p-2 text-slate-300 hover:text-emerald-400 hover:bg-slate-800/60 rounded-full transition-all" title="Show All Hidden Structures">
                    <i class="fa-solid fa-eye text-sm"></i>
                </button>
                <div class="h-4 w-px bg-slate-700"></div>
                <button onclick="toggleWireframe()" id="btn-wireframe" class="p-2 text-slate-300 hover:text-sky-400 hover:bg-slate-800/60 rounded-full transition-all" title="Toggle Wireframe Mode">
                    <i class="fa-solid fa-cubes-stacked text-sm"></i>
                </button>
            </div>

            <!-- Quiz Top Banner Overlay (hidden by default) -->
            <div id="quiz-hud" class="hidden absolute top-4 left-1/2 -translate-x-1/2 glass-panel rounded-xl px-6 py-3 border border-amber-500/30 flex items-center space-x-6 z-10 shadow-xl">
                <div>
                    <div class="text-[10px] text-amber-400 uppercase font-bold tracking-wider">Identification Challenge</div>
                    <div id="quiz-question" class="text-sm font-semibold text-white">Click on the: <span class="text-amber-300 underline underline-offset-4 font-bold">Femur</span></div>
                </div>
                <div class="flex items-center space-x-4 border-l border-slate-700 pl-5">
                    <div class="text-center">
                        <div class="text-[10px] text-slate-400 uppercase font-semibold">Score</div>
                        <div id="quiz-score" class="text-base font-bold text-emerald-400">0</div>
                    </div>
                    <button onclick="nextQuizQuestion()" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-lg transition-colors">
                        Skip
                    </button>
                </div>
            </div>

            <!-- Hover Tooltip -->
            <div id="3d-tooltip" class="hidden fixed glass-panel px-3 py-1.5 rounded-lg text-xs font-semibold text-sky-300 z-30 pointer-events-none shadow-lg border border-sky-400/30">
                <span id="tooltip-text">Structure</span>
            </div>
        </main>

        <!-- Right Sidebar / Selected Structure Anatomy Inspector -->
        <aside id="detail-panel" class="w-96 border-l border-slate-800/80 bg-slate-950/80 backdrop-blur-md flex flex-col z-20 transition-all duration-300">
            <!-- Header -->
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-notes-medical text-sky-400 text-sm"></i>
                    <h2 class="font-bold text-sm text-slate-100">Anatomical Details</h2>
                </div>
                <span id="structure-system-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-800 text-slate-400">
                    Select Part
                </span>
            </div>

            <!-- Detail Body Container -->
            <div id="detail-content" class="flex-1 overflow-y-auto p-4 space-y-4">
                <!-- Empty Placeholder state when nothing selected -->
                <div id="empty-detail-state" class="h-full flex flex-col items-center justify-center text-center p-6 text-slate-500">
                    <i class="fa-solid fa-hand-pointer text-3xl mb-3 text-slate-600 animate-bounce"></i>
                    <p class="text-xs font-medium">Click on any 3D organ, bone, or muscle to inspect detailed anatomical structure.</p>
                </div>

                <!-- Active Structure Details Container (Hidden when empty) -->
                <div id="active-detail-state" class="hidden space-y-4">
                    <div>
                        <h3 id="detail-title" class="text-xl font-extrabold text-white">Femur</h3>
                        <p id="detail-latin" class="text-xs text-sky-400 italic font-medium">Os femoris</p>
                    </div>

                    <!-- Tabs: Overview / Function / Clinical Notes -->
                    <div class="space-y-3">
                        <div class="bg-slate-900/90 rounded-lg p-3 border border-slate-800">
                            <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-1 flex items-center space-x-1.5">
                                <i class="fa-solid fa-align-left text-sky-400"></i>
                                <span>Overview</span>
                            </h4>
                            <p id="detail-description" class="text-xs text-slate-300 leading-relaxed">
                                Longest and strongest bone in the human body...
                            </p>
                        </div>

                        <div class="bg-slate-900/90 rounded-lg p-3 border border-slate-800">
                            <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-1 flex items-center space-x-1.5">
                                <i class="fa-solid fa-gears text-emerald-400"></i>
                                <span>Primary Function</span>
                            </h4>
                            <p id="detail-function" class="text-xs text-slate-300 leading-relaxed">
                                Supports weight and facilitates leg movement...
                            </p>
                        </div>

                        <div class="bg-slate-900/90 rounded-lg p-3 border border-slate-800">
                            <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-1 flex items-center space-x-1.5">
                                <i class="fa-solid fa-stethoscope text-amber-400"></i>
                                <span>Clinical Notes</span>
                            </h4>
                            <p id="detail-clinical" class="text-xs text-slate-300 leading-relaxed">
                                Susceptible to fractures in high-impact trauma or elderly osteoporosis...
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

    </div>

